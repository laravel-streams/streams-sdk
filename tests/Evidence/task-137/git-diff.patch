+++            'handle' => $handle,
+++            'kind' => $kind,
+++            'source' => $relative,
+++            'settings' => $settings,
+++            'opaque' => $opaque,
+++        ];
+++    }
+++
+++    /**
+++     * @return list<Node>|null
+++     */
+++    protected function parse(string $file): ?array
+++    {
+++        $parser = (new ParserFactory)->create(ParserFactory::PREFER_PHP7);
+++
+++        try {
+++            return $parser->parse((string) file_get_contents($file)) ?: null;
+++        } catch (\Throwable) {
+++            return null;
+++        }
+++    }
