+++        if (str_starts_with($file, $real)) {
+++            return substr($file, strlen($real));
+++        }
+++
+++        return basename($file);
+++    }
+++
+++    protected function snake(string $value): string
+++    {
+++        $snake = strtolower((string) preg_replace('/(?<!^)[A-Z]/', '_$0', $value));
+++
+++        return str_replace('-', '_', $snake);
+++    }
+++}
