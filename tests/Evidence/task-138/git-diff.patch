+        $original = File::get($absolute);
+        $edited = str_replace("return 'Add person';", "return 'Added by hand';", $original);
+
+        $this->assertNotSame($original, $edited);
+        File::put($absolute, $edited);
+
+        $dry = $this->runJson(['--fix' => true, '--dry-run' => true]);
+
+        $this->assertSame($edited, File::get($absolute));
+        $this->assertSame('people.actions.add', $dry['report']['failed'][0]['path']);
+        $this->assertSame($relative, $dry['report']['failed'][0]['file']);
+        $this->assertStringContainsString('hand edit', $dry['report']['failed'][0]['reason']);
+        $this->assertSame('regenerate '.$relative.' from the app tree', $dry['report']['failed'][0]['suggestedChange']);
+
+        $code = Artisan::call('streams:make', [
+            '--tree' => $this->fixture,
+            '--output' => $this->output,
+            '--fix' => true,
+            '--dry-run' => true,
+        ]);
+        $text = Artisan::output();
+
+        $this->assertSame(0, $code, $text);
+        $this->assertStringContainsString('would fix: people.actions.add '.$relative, $text);
+        $this->assertSame($edited, File::get($absolute));
+        $this->assertStringNotContainsString('fixed: people.actions.add', $text);
+
+        $code = Artisan::call('streams:make', [
+            '--tree' => $this->fixture,
+            '--output' => $this->output,
+            '--fix' => true,
+        ]);
+        $text = Artisan::output();
+
+        $this->assertSame(0, $code, $text);
+        $this->assertStringContainsString('fixed: people.actions.add '.$relative, $text);
+        $this->assertNotSame($edited, File::get($absolute));
+        $this->assertStringContainsString("return 'Add person';", File::get($absolute));
+        $this->assertStringContainsString('Generated by streams/sdk', File::get($absolute));
+
+        File::put($absolute, str_replace("return 'Add person';", "return 'Hand edited again';", File::get($absolute)));
+
+        $real = $this->runJson(['--fix' => true]);
+
+        $this->assertNotSame($edited, File::get($absolute));
+        $this->assertStringContainsString("return 'Add person';", File::get($absolute));
+        $this->assertStringContainsString('Generated by streams/sdk', File::get($absolute));
+        $this->assertSame([], $real['conflicts']);
+        $this->assertSame([], $real['report']['failed']);
+        $this->assertCount(1, $real['report']['fixed']);
+        $this->assertSame('people.actions.add', $real['report']['fixed'][0]['path']);
+        $this->assertSame($relative, $real['report']['fixed'][0]['file']);
+        $this->assertStringContainsString('hand edit', $real['report']['fixed'][0]['reason']);
+        $this->assertStringContainsString('regenerate '.$relative, $real['report']['fixed'][0]['suggestedChange']);
+        $this->assertSame(
+            StreamLock::hashContents(File::get($absolute)),
+            StreamLock::read($this->output)->hash('people.actions.add', $relative),
+        );
+    }
