<?php

namespace {{ namespace }};

use Livewire\Component;
use Livewire\WithPagination;
use Streams\Core\Support\Facades\Streams;

class {{ class }} extends Component
{
    use WithPagination;

    public string $sortField = '{{ sortField }}';

    public string $sortDirection = 'asc';

    public int $perPage = 15;

    protected $queryString = [
        'sortField' => ['except' => '{{ sortField }}'],
        'sortDirection' => ['except' => 'asc'],
    ];

    public function sortBy(string $field): void
    {
        if (! Streams::make('{{ stream }}')->fields->has($field)) {
            return;
        }

        $this->sortDirection = $this->sortField === $field && $this->sortDirection === 'asc' ? 'desc' : 'asc';

        $this->sortField = $field;

        $this->resetPage();
    }

    public function updatedPerPage(): void
    {
        $this->resetPage();
    }

    public function delete(string $id): void
    {
        if ($entry = Streams::repository('{{ stream }}')->find($id)) {
            $entry->delete();

            session()->flash('message', '{{ title }} entry deleted.');
        }
    }

    public function render()
    {
        $entries = Streams::entries('{{ stream }}')
            ->orderBy($this->sortField, $this->sortDirection)
            ->paginate([
                'per_page' => $this->perPage,
                'page' => $this->getPage(),
            ]);

        return view('{{ view }}', [
            'entries' => $entries,
        ]);
    }
}
