{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://streams.dev/schema/node/column.schema.json",
    "title": "Column node",
    "description": "A table column. Addressed at people.table.columns.name.",
    "type": "object",
    "allOf": [
        {
            "$ref": "https://streams.dev/schema/node/base.schema.json"
        }
    ],
    "additionalProperties": true,
    "properties": {
        "handle": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
            "type": "string"
        },
        "format": {
            "type": "string"
        },
        "visible": {
            "type": "boolean"
        },
        "config": {
            "type": "object"
        }
    }
}
