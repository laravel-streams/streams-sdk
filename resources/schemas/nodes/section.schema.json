{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://streams.dev/schema/node/section.schema.json",
    "title": "Form section node",
    "description": "A form section. Addressed at people.actions.add.form.sections.basics.",
    "type": "object",
    "allOf": [
        {
            "$ref": "https://streams.dev/schema/node/base.schema.json"
        }
    ],
    "additionalProperties": true,
    "properties": {
        "handle": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
            "type": "string"
        },
        "fields": {
            "type": "array",
            "items": {
                "type": "object"
            }
        },
        "config": {
            "type": "object"
        }
    }
}
