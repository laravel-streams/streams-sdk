diff --git a/src/Console/Make/ComponentRenderer.php b/src/Console/Make/ComponentRenderer.php
new file mode 100644
index 0000000..584ab8d
--- /dev/null
+++ b/src/Console/Make/ComponentRenderer.php
@@ -0,0 +1,163 @@
+<?php
+
+namespace Streams\Sdk\Console\Make;
+
+use Illuminate\Support\Str;
+use Streams\Sdk\Support\AppTree;
+
+/** The people manage slice uses the same builder shape as the pinned references. */
+class ComponentRenderer
+{
+    public function __construct(protected Paths $paths) {}
+
+    public function render(AppTree $tree, string $path, string $type, string $namespace, string $class, string $fallback): string
+    {
+        $node = $tree->node($path);
+        $stream = explode('.', $path)[0];
+        $body = null;
+        $imports = [];
+        $extends = '';
+
+        if ($type === 'table') {
+            $imports = ['Streams\\Ui\\Builders\\Tables\\Columns\\TextColumn', 'Streams\\Ui\\Builders\\Tables\\Table'];
+            $extends = 'Table';
+            $columns = [];
+            foreach ($node['columns'] ?? [] as $handle => $column) {
+                $handle = $column['handle'] ?? $handle;
+                $label = $column['label'] ?? Str::headline($handle);
+                $columns[] = '                TextColumn::make('.var_export($handle, true).')'."\n".
+                    '                    ->label('.var_export($label, true).'),';
+            }
+            $columns = implode("\n", $columns);
+            $query = var_export($stream, true);
+            $body = <<<PHP
+    protected function setUp(): void
+    {
+        \$this
+            ->columns([
+{$columns}
+            ])
+            ->query(entries({$query}));
+    }
+PHP;
+        } elseif ($type === 'page' && isset($node['table']) && is_string($node['table'])) {
+            $tablePath = str_contains($node['table'], '.') ? $node['table'] : $stream.'.'.$node['table'];
+            if (! $tree->has($tablePath) || $tree->type($tablePath) !== 'table') {
+                return $fallback;
+            }
+            $table = $tree->classForPath($tablePath);
+            $imports = [
+                $this->qualified($tree, $tablePath, 'table'),
+                'App\\Livewire\\PanelPage',
+                'Streams\\Ui\\Builders\\Containers\\Container',
+                'Streams\\Ui\\Builders\\Headings\\Heading',
+                'Streams\\Ui\\Livewire\\Tables\\InteractsWithTables',
+            ];
+            $extends = 'PanelPage';
+            $actions = '';
+            $register = '';
+            $trait = '';
+            if ($tree->has($stream.'.actions.add')) {
+                $actionPath = $stream.'.actions.add';
+                $action = $tree->classForPath($actionPath);
+                $imports[] = $this->qualified($tree, $actionPath, 'action');
+                $imports[] = 'Streams\\Ui\\Livewire\\Actions\\InteractsWithActions';
+                $trait = "    use InteractsWithActions;\n";
+                $register = "        {$action}::register(\$this);\n";
+                $actions = "                            {$action}::resolve(),\n";
+            }
+            $title = var_export($node['title'] ?? $stream, true);
+            $body = <<<PHP
+{$trait}    use InteractsWithTables;
+
+    public function boot(): void
+    {
+{$register}        {$table}::register(\$this);
+    }
+
+    public function getComponents(): array
+    {
+        return [
+            Container::make('group')
+                ->components([
+                    Heading::make({$title})
+                        ->actions([
+{$actions}                        ]),
+                    {$table}::resolve(),
+                ]),
+        ];
+    }
+PHP;
+        } elseif ($type === 'action' && ($node['type'] ?? null) === 'modal' && $tree->has($path.'.form')) {
+            $form = $tree->classForPath($path.'.form');
+            $imports = [$this->qualified($tree, $path.'.form', 'form'), 'Streams\\Ui\\Builders\\Actions\\MountableAction'];
+            $extends = 'MountableAction';
+            $label = var_export($node['label'] ?? $path, true);
+            $body = <<<PHP
+    protected function setUp(): void
+    {
+        \$name = \$this->getName();
+        {$form}::register(\$this->getLivewire());
+
+        \$this
+            ->label({$label})
+            ->modalWidth('xl')
+            ->modalHeading({$label})
+            ->modalComponents(fn (): array => [{$form}::resolve()])
+            ->mergeHtmlAttributes([
+                'wire:click' => 'mountAction(\''.\$name.'\')',
+            ]);
+    }
+PHP;
+        } elseif ($type === 'form') {
+            $imports = ['Streams\\Ui\\Builders\\Forms\\Form'];
+            $extends = 'Form';
+            $fields = [];
+            foreach ($node['sections'] ?? [] as $section => $data) {
+                $sectionPath = $path.'.sections.'.$section;
+                $data = $tree->has($sectionPath) ? $tree->node($sectionPath) : $data;
+                foreach ($data['fields'] ?? [] as $field) {
+                    $fields[] = '                '.var_export($field['handle'], true).',';
+                }
+            }
+            $fields = implode("\n", $fields);
+            $streamName = var_export($stream, true);
+            $body = <<<PHP
+    protected function setUp(): void
+    {
+        \$this
+            ->stream({$streamName})
+            ->fields([
+{$fields}
+            ]);
+    }
+PHP;
+        }
+
+        if ($body === null) {
+            return $fallback;
+        }
+
+        // Retain the node metadata methods and ownership tag from the build stage.
+        $imports[] = 'Streams\\Sdk\\Attributes\\Generated';
+        sort($imports);
+        $uses = implode("\n", array_map(fn (string $import): string => 'use '.$import.';', $imports));
+        $source = str_replace('use Streams\\Sdk\\Attributes\\Generated;', $uses, $fallback);
+        $source = str_replace('class '.$class."\n{", 'class '.$class.' extends '.$extends."\n{\n".$body."\n", $source);
+        $source = str_replace('public function label(): string', 'public function generatedLabel(): string', $source);
+
+        return $source;
+    }
+
+    public function qualified(AppTree $tree, string $path, string $type): string
+    {
+        $class = $tree->classForPath($path);
+        $relative = $this->paths->resolve($type, Str::studly(explode('.', $path)[0]), $class);
+
+        if ($relative === null) {
+            throw new \RuntimeException('No output path for ['.$path.'].');
+        }
+
+        return $this->paths->namespaceFor($relative).'\\'.$class;
+    }
+}
diff --git a/src/Console/Make/PageActionEditor.php b/src/Console/Make/PageActionEditor.php
new file mode 100644
index 0000000..b4813da
--- /dev/null
+++ b/src/Console/Make/PageActionEditor.php
@@ -0,0 +1,110 @@
+<?php
+
+namespace Streams\Sdk\Console\Make;
+
+use PhpParser\Node;
+use PhpParser\Node\Arg;
+use PhpParser\Node\Expr\Array_;
+use PhpParser\Node\Expr\ArrayItem;
+use PhpParser\Node\Expr\MethodCall;
+use PhpParser\Node\Expr\StaticCall;
+use PhpParser\Node\Expr\Variable;
+use PhpParser\Node\Identifier;
+use PhpParser\Node\Name;
+use PhpParser\Node\Name\FullyQualified;
+use PhpParser\Node\Stmt\Class_;
+use PhpParser\Node\Stmt\Expression;
+use PhpParser\Node\Stmt\Use_;
+use PhpParser\NodeFinder;
+use PhpParser\PrettyPrinter\Standard;
+use Streams\Sdk\Console\Support\PhpEditor;
+
+/** Attach one modal to a page without replacing the author's page implementation. */
+class PageActionEditor
+{
+    public function attach(string $source, string $file, string $class, string $action): string
+    {
+        $editor = PhpEditor::fromString($source, $file);
+        $finder = new NodeFinder;
+        $classes = $finder->find($editor->statements(), fn (Node $node): bool => $node instanceof Class_ && $node->name?->toString() === $class);
+        if (count($classes) !== 1) {
+            throw new \RuntimeException('expected one class declaration for '.$class);
+        }
+        $page = $classes[0];
+        $boot = $page->getMethod('boot');
+        $components = $page->getMethod('getComponents');
+        if ($boot === null || $boot->stmts === null || $components === null) {
+            throw new \RuntimeException('boot() and getComponents() are required');
+        }
+
+        $calls = $finder->find($components->stmts ?? [], function (Node $node): bool {
+            if (! $node instanceof MethodCall || ! $node->name instanceof Identifier || $node->name->toString() !== 'actions') {
+                return false;
+            }
+            $receiver = $node->var;
+            while ($receiver instanceof MethodCall) {
+                $receiver = $receiver->var;
+            }
+
+            return $receiver instanceof StaticCall
+                && $receiver->class instanceof Name
+                && $receiver->class->getLast() === 'Heading'
+                && isset($node->args[0])
+                && $node->args[0]->value instanceof Array_;
+        });
+        if (count($calls) !== 1) {
+            throw new \RuntimeException('expected one Heading actions array in getComponents()');
+        }
+
+        $traits = $finder->findInstanceOf($page->stmts, Node\Stmt\TraitUse::class);
+        $hasActions = false;
+        foreach ($traits as $use) {
+            foreach ($use->traits as $trait) {
+                $hasActions = $hasActions || $trait->getLast() === 'InteractsWithActions';
+            }
+        }
+        if (! $hasActions) {
+            throw new \RuntimeException('InteractsWithActions trait is required');
+        }
+
+        // Reuse an existing import (including aliases); otherwise use the FQCN.
+        $name = new FullyQualified($action);
+        foreach ($finder->findInstanceOf($editor->statements(), Use_::class) as $use) {
+            if ($use->type !== Use_::TYPE_NORMAL) {
+                continue;
+            }
+            foreach ($use->uses as $import) {
+                if (strcasecmp($import->name->toString(), $action) === 0) {
+                    $name = new Name($import->getAlias()->toString());
+                }
+            }
+        }
+
+        $array = $calls[0]->args[0]->value;
+        if ($array->items === []) {
+            $lines = explode("\n", $source);
+            $span = implode("\n", array_slice($lines, $array->getStartLine() - 1, $array->getEndLine() - $array->getStartLine() + 1));
+            if (str_contains($span, '//') || str_contains($span, '/*')) {
+                throw new \RuntimeException('empty actions array contains comments that cannot be preserved');
+            }
+        }
+        $editor->appendToArray(
+            fn (Array_ $candidate): bool => $candidate === $array,
+            new ArrayItem(new StaticCall(clone $name, new Identifier('resolve'))),
+        );
+
+        $register = new Expression(new StaticCall(clone $name, new Identifier('register'), [new Arg(new Variable('this'))]));
+        $printer = new Standard;
+        $exists = false;
+        foreach ($boot->stmts as $statement) {
+            if ($printer->prettyPrint([$statement]) === $printer->prettyPrint([$register])) {
+                $exists = true;
+            }
+        }
+        if (! $exists) {
+            $boot->stmts[] = $register;
+        }
+
+        return $editor->print();
+    }
+}
