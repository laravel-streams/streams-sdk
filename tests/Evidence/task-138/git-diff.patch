+++ b/src/Console/Make/Reports/FixProvider.php
@@ -0,0 +1,21 @@
+<?php
+
+namespace Streams\Sdk\Console\Make\Reports;
+
+/**
+ * Decides whether a FailedEdit can be solved and proposes solutions for it.
+ *
+ * This mirrors Spatie Ignition's HasSolutionsForThrowable shape
+ * (canSolve(Throwable) / getSolutions(Throwable)) adapted to FailedEdit so
+ * the SDK has no Spatie dependency. Providers registered in FixRegistry run
+ * after a build, before the report is rendered.
+ */
+interface FixProvider
+{
+    public function canSolve(FailedEdit $edit): bool;
+
+    /**
+     * @return list<FixSolution>
+     */
+    public function getSolutions(FailedEdit $edit): array;
+}
diff --git a/src/Console/Make/Reports/FixRegistry.php b/src/Console/Make/Reports/FixRegistry.php
new file mode 100644
index 0000000..cc4d94a
--- /dev/null
+++ b/src/Console/Make/Reports/FixRegistry.php
@@ -0,0 +1,72 @@
+<?php
+
+namespace Streams\Sdk\Console\Make\Reports;
+
+/**
+ * Runs the FixProviders that can solve the failed edits of a build.
+ *
+ * Providers are asked in registration order. The first provider that can
+ * solve a FailedEdit provides the solutions for that edit. The engine has
+ * no Spatie dependency: this mirrors Spatie's solution registry with our
+ * own canSolve(FailedEdit) / getSolutions(FailedEdit) contract.
+ */
+class FixRegistry
+{
+    /**
+     * @var list<FixProvider>
+     */
+    protected array $providers = [];
+
+    /**
+     * @param  list<FixProvider>  $providers
+     */
+    public function __construct(array $providers = [])
+    {
+        foreach ($providers as $provider) {
+            $this->add($provider);
+        }
+    }
+
+    public function add(FixProvider $provider): self
+    {
+        $this->providers[] = $provider;
+
+        return $this;
+    }
+
+    /**
+     * @return list<FixProvider>
+     */
+    public function providers(): array
+    {
+        return $this->providers;
+    }
+
+    /**
+     * The first provider that can solve $edit.
+     */
+    public function providerFor(FailedEdit $edit): ?FixProvider
+    {
+        foreach ($this->providers as $provider) {
+            if ($provider->canSolve($edit)) {
+                return $provider;
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * @return list<FixSolution>
+     */
+    public function solutionsFor(FailedEdit $edit): array
+    {
+        $provider = $this->providerFor($edit);
+
+        if ($provider === null) {
+            return [];
+        }
+
+        return $provider->getSolutions($edit);
+    }
+}
diff --git a/src/Console/Make/Reports/FixSolution.php b/src/Console/Make/Reports/FixSolution.php
new file mode 100644
index 0000000..f60a05b
--- /dev/null
+++ b/src/Console/Make/Reports/FixSolution.php
@@ -0,0 +1,36 @@
+<?php
+
+namespace Streams\Sdk\Console\Make\Reports;
+
+/**
+ * A fix proposed for one FailedEdit.
+ *
+ * The shape mirrors Spatie Ignition's Solution + RunnableSolution contract:
+ * a solution has a title, a description, documentation links, and (when
+ * runnable) a run() with parameters. The SDK itself does not require Spatie;
+ * see FixSolutionContract for the union that satisfies Spatie interfaces
+ * only when they exist.
+ */
+interface FixSolution
+{
+    public function getSolutionTitle(): string;
+
+    public function getSolutionDescription(): string;
+
+    /**
+     * @return array<string, string>
+     */
+    public function getDocumentationLinks(): array;
+
+    /**
+     * Apply this fix. When the solution is runnable the command calls run();
+     * otherwise apply() must do the work.
+     */
+    public function apply(): bool;
+
+    /**
+     * A short line describing the change this fix would make, shown by the
+     * report renderer and by --dry-run previews.
+     */
+    public function getSolutionChangeSummary(): string;
+}
diff --git a/src/Console/Make/Reports/FixSolutionContract.php b/src/Console/Make/Reports/FixSolutionContract.php
new file mode 100644
index 0000000..6d455c2
--- /dev/null
+++ b/src/Console/Make/Reports/FixSolutionContract.php
@@ -0,0 +1,22 @@
+<?php
+
+namespace Streams\Sdk\Console\Make\Reports;
+
+use Spatie\Ignition\Contracts\RunnableSolution as SpatieRunnableSolution;
+use Spatie\Ignition\Contracts\Solution as SpatieSolution;
+
+/**
+ * A FixSolution that also satisfies Spatie Ignition's contracts whenever
+ * spatie/ignition is installed.
+ *
+ * Spatie is optional (composer suggest, never require): without it this
+ * interface is just FixSolution. When Spatie's Solution and RunnableSolution
+ * interfaces are present, the same interface extends them, so the SDK's fix
+ * solutions surface in Ignition and Flare without the engine depending on a
+ * spatie package.
+ */
+if (interface_exists(SpatieSolution::class) && interface_exists(SpatieRunnableSolution::class)) {
+    interface FixSolutionContract extends FixSolution, SpatieRunnableSolution, SpatieSolution {}
+} else {
+    interface FixSolutionContract extends FixSolution {}
+}
