@@ -0,0 +1,98 @@
+<?php
+
+namespace Streams\Sdk\Console\Make\Kinds;
+
+/**
+ * One input on a component kind.
+ *
+ * The JSON key, the prompt, and the flag all come from this definition.
+ * A kind is data for streams:make. It is never registered as a command.
+ */
+class InputField
+{
+    /**
+     * @param  list<string>  $enum
+     */
+    public function __construct(
+        public readonly string $key,
+        public readonly string $type,
+        public readonly bool $required = false,
+        public readonly ?string $prompt = null,
+        public readonly ?string $flag = null,
+        public readonly array $enum = [],
+        public readonly ?string $pattern = null,
+        public readonly ?string $description = null,
+    ) {}
+
+    public static function make(string $key, string $type): self
+    {
+        return new self($key, $type);
+    }
+
+    public static function string(string $key): self
+    {
+        return new self($key, 'string');
+    }
+
+    public function required(): self
+    {
+        return $this->copy(required: true);
+    }
+
+    public function type(string $type): self
+    {
+        return $this->copy(type: $type);
+    }
+
+    public function prompt(string $prompt): self
+    {
+        return $this->copy(prompt: $prompt);
+    }
+
+    public function flag(string $flag): self
+    {
+        return $this->copy(flag: $flag);
+    }
+
+    /**
+     * @param  list<string>  $enum
+     */
+    public function enum(array $enum): self
+    {
+        return $this->copy(enum: $enum);
+    }
+
+    public function pattern(string $pattern): self
+    {
+        return $this->copy(pattern: $pattern);
+    }
+
+    public function description(string $description): self
+    {
+        return $this->copy(description: $description);
+    }
+
+    /**
+     * @param  list<string>|null  $enum
+     */
+    protected function copy(
+        ?string $type = null,
+        ?bool $required = null,
+        ?string $prompt = null,
+        ?string $flag = null,
+        ?array $enum = null,
+        ?string $pattern = null,
+        ?string $description = null,
+    ): self {
+        return new self(
+            $this->key,
+            $type ?? $this->type,
+            $required ?? $this->required,
+            $prompt ?? $this->prompt,
+            $flag ?? $this->flag,
+            $enum ?? $this->enum,
+            $pattern ?? $this->pattern,
+            $description ?? $this->description,
+        );
+    }
+}
diff --git a/src/Console/Make/Kinds/Kind.php b/src/Console/Make/Kinds/Kind.php
new file mode 100644
index 0000000..d5794bf
--- /dev/null
+++ b/src/Console/Make/Kinds/Kind.php
@@ -0,0 +1,280 @@
+<?php
+
+namespace Streams\Sdk\Console\Make\Kinds;
+
+/**
+ * A component kind streams:make can produce.
+ *
+ * The input schema drives prompts, flags, and JSON keys. Kinds are registry
+ * data. Registering a kind does not register a command.
+ */
+class Kind
+{
+    /**
+     * @param  list<InputField>  $inputs
+     * @param  list<ChainLink>  $chain
+     * @param  array<string, array{field: string, equals: string}>  $requiredWhen
+     */
+    public function __construct(
+        public readonly string $name,
+        public readonly string $description,
+        public readonly array $inputs,
+        public readonly array $chain = [],
+        public readonly array $requiredWhen = [],
+        public readonly ?Placement $placement = null,
+        public readonly ?string $source = null,
+        public readonly ?string $package = null,
+        public readonly ?string $nodeType = null,
+    ) {}
+
+    /**
+     * @param  list<InputField>  $inputs
+     * @param  list<ChainLink>  $chain
+     * @param  array<string, array{field: string, equals: string}>  $requiredWhen
+     */
+    public static function define(
+        string $name,
+        string $description,
+        array $inputs,
+        array $chain = [],
+        array $requiredWhen = [],
+        ?string $nodeType = null,
+    ): self {
+        return new self($name, $description, $inputs, $chain, $requiredWhen, null, null, null, $nodeType);
+    }
+
+    public function fromSource(string $source, ?string $package = null): self
+    {
+        return new self(
+            $this->name,
+            $this->description,
+            $this->inputs,
+            $this->chain,
+            $this->requiredWhen,
+            $this->placement,
+            $source,
+            $package,
+            $this->nodeType,
+        );
+    }
+
+    /**
+     * Attach this kind under an existing tree parent so streams:make can
+     * address it by dot path.
+     */
+    public function placedOn(string $parent, string $key, bool $map, ?string $mapOf = null): self
+    {
+        return new self(
+            $this->name,
+            $this->description,
+            $this->inputs,
+            $this->chain,
+            $this->requiredWhen,
+            new Placement($parent, $key, $map, $mapOf),
+            $this->source,
+            $this->package,
+            $this->nodeType,
+        );
+    }
+
+    /**
+     * The app-tree node type this kind validates.
+     */
+    public function resolvedType(): string
+    {
+        return $this->nodeType ?? $this->name;
+    }
+
+    public function input(string $key): ?InputField
+    {
+        foreach ($this->inputs as $input) {
+            if ($input->key === $key) {
+                return $input;
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * JSON keys in schema order.
+     *
+     * @return list<string>
+     */
+    public function keys(): array
+    {
+        return array_map(fn (InputField $input): string => $input->key, $this->inputs);
+    }
+
+    /**
+     * Prompts keyed by JSON key.
+     *
+     * @return array<string, string>
+     */
+    public function prompts(): array
+    {
+        $prompts = [];
+
+        foreach ($this->inputs as $input) {
+            if ($input->prompt !== null) {
+                $prompts[$input->key] = $input->prompt;
+            }
+        }
+
+        return $prompts;
+    }
+
+    /**
+     * Artisan flag name => JSON key.
+     *
+     * @return array<string, string>
+     */
+    public function flags(): array
+    {
+        $flags = [];
+
+        foreach ($this->inputs as $input) {
+            if ($input->flag !== null) {
+                $flags[$input->flag] = $input->key;
+            }
+        }
+
+        return $flags;
+    }
+
+    /**
+     * Validate an input payload.
+     *
+     * Each error names its field. An empty list means the input is valid.
+     *
+     * @param  array<string, mixed>  $input
+     * @return list<array{field: string, message: string}>
+     */
+    public function validate(array $input): array
+    {
+        $errors = [];
+
+        foreach ($this->inputs as $field) {
+            $value = $input[$field->key] ?? null;
+            $present = $this->present($value);
+
+            if (! $present) {
+                if ($field->required) {
+                    $errors[] = [
+                        'field' => $field->key,
+                        'message' => "The {$field->key} field is required.",
+                    ];
+                }
+
+                continue;
+            }
+
+            if (! $this->typeMatches($field->type, $value)) {
+                $errors[] = [
+                    'field' => $field->key,
+                    'message' => "The {$field->key} field must be a {$field->type}.",
+                ];
+
+                continue;
+            }
+
+            if ($field->enum !== [] && ! in_array($value, $field->enum, true)) {
+                $errors[] = [
+                    'field' => $field->key,
+                    'message' => 'The '.$field->key.' field must be one of: '.implode(', ', $field->enum).'.',
+                ];
+            }
+
+            if (is_string($value) && $field->pattern !== null && preg_match($field->pattern, $value) !== 1) {
+                $errors[] = [
+                    'field' => $field->key,
+                    'message' => "The {$field->key} field format is invalid.",
+                ];
+            }
+        }
+
+        foreach ($this->requiredWhen as $key => $rule) {
+            if (($input[$rule['field']] ?? null) !== $rule['equals']) {
+                continue;
+            }
+
+            if ($this->present($input[$key] ?? null)) {
+                continue;
+            }
+
+            $errors[] = [
+                'field' => $key,
+                'message' => "The {$key} field is required when {$rule['field']} is {$rule['equals']}.",
+            ];
+        }
+
+        return $errors;
+    }
+
+    /**
+     * Child nodes this kind produces. Paths are relative to the stream handle.
+     *
+     * @param  array<string, mixed>  $input
+     * @return list<array{kind: string, path: string, input: array<string, mixed>}>
+     */
+    public function expand(array $input): array
+    {
+        $steps = [];
+
+        foreach ($this->chain as $link) {
+            $steps[] = [
+                'kind' => $link->kind,
+                'path' => $link->path,
+                'input' => $link->resolve($input),
+            ];
+        }
+
+        return $steps;
+    }
+
+    /**
+     * Same as expand(), with the stream handle prefixed onto each dot path.
+     *
+     * @param  array<string, mixed>  $input
+     * @return list<array{kind: string, path: string, input: array<string, mixed>}>
+     */
+    public function expandUnder(string $stream, array $input): array
+    {
+        $steps = $this->expand($input);
+
+        if ($stream === '') {
+            return $steps;
+        }
+
+        foreach ($steps as $index => $step) {
+            $steps[$index]['path'] = $stream.'.'.$step['path'];
+        }
+
+        return $steps;
+    }
+
+    protected function present(mixed $value): bool
+    {
+        return $value !== null && $value !== '';
+    }
+
+    protected function typeMatches(string $type, mixed $value): bool
+    {
+        foreach (explode('|', $type) as $option) {
+            $matches = match ($option) {
+                'string' => is_string($value),
+                'boolean' => is_bool($value),
+                'integer' => is_int($value),
+                'array' => is_array($value) && array_is_list($value),
+                'object' => is_array($value) && ($value === [] || ! array_is_list($value)),
+                default => false,
+            };
+
+            if ($matches) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
diff --git a/src/Console/Make/Kinds/KindRegistry.php b/src/Console/Make/Kinds/KindRegistry.php
new file mode 100644
index 0000000..92c50c2
--- /dev/null
+++ b/src/Console/Make/Kinds/KindRegistry.php
@@ -0,0 +1,207 @@
+<?php
+
+namespace Streams\Sdk\Console\Make\Kinds;
+
+use Streams\Sdk\Support\AppTree;
+
+/**
+ * Registry of component kinds streams:make can produce.
+ *
+ * The SDK, an app, and a package each register kinds through this API.
+ * Registration stores data only. It does not register an Artisan command.
+ */
+class KindRegistry
+{
+    /**
+     * @var array<string, Kind>
+     */
+    protected array $kinds = [];
+
+    /**
+     * Node type => kind name.
+     *
+     * @var array<string, string>
+     */
+    protected array $byType = [];
+
+    public static function withBuiltIns(): self
+    {
+        $registry = new self;
+
+        foreach (BuiltInKinds::all() as $kind) {
+            $registry->registerFromSdk($kind);
+        }
+
+        return $registry;
+    }
+
+    /**
+     * Read app and package kinds from config('streams.sdk.make.kinds').
+     */
+    public function loadConfigured(): self
+    {
+        $configured = config('streams.sdk.make.kinds', []);
+
+        if (! is_array($configured)) {
+            return $this;
+        }
+
+        foreach ($configured['app'] ?? [] as $kind) {
+            if ($kind instanceof Kind) {
+                $this->registerFromApp($kind);
+            }
+        }
+
+        $packages = $configured['packages'] ?? [];
+
+        if (is_array($packages)) {
+            foreach ($packages as $package => $kinds) {
+                if (! is_string($package) || ! is_array($kinds)) {
+                    continue;
+                }
+
+                foreach ($kinds as $kind) {
+                    if ($kind instanceof Kind) {
+                        $this->registerFromPackage($kind, $package);
+                    }
+                }
+            }
+        }
+
+        return $this;
+    }
+
+    public function registerFromSdk(Kind $kind): void
+    {
+        $this->add($kind->fromSource('sdk'));
+    }
+
+    public function registerFromApp(Kind $kind): void
+    {
+        $this->add($kind->fromSource('app'));
+    }
+
+    public function registerFromPackage(Kind $kind, string $package): void
+    {
+        $this->add($kind->fromSource('package', $package));
+    }
+
+    public function has(string $name): bool
+    {
+        return isset($this->kinds[$name]);
+    }
+
+    public function get(string $name): Kind
+    {
+        if (! isset($this->kinds[$name])) {
+            throw new KindRegistryException("Unknown component kind [{$name}].");
+        }
+
+        return $this->kinds[$name];
+    }
+
+    /**
+     * The kind for an app-tree node type, when one is registered.
+     */
+    public function forType(string $type): ?Kind
+    {
+        $name = $this->byType[$type] ?? null;
+
+        return $name === null ? null : $this->kinds[$name];
+    }
+
+    /**
+     * The kind streams:make uses for a dot path, when the node has one.
+     */
+    public function forPath(AppTree $tree, string $path): ?Kind
+    {
+        $type = $tree->type($path);
+
+        if ($type === null) {
+            return null;
+        }
+
+        return $this->forType($type);
+    }
+
+    /**
+     * @return list<Kind>
+     */
+    public function all(): array
+    {
+        return array_values($this->kinds);
+    }
+
+    /**
+     * @return list<string>
+     */
+    public function names(): array
+    {
+        return array_keys($this->kinds);
+    }
+
+    /**
+     * @return list<Kind>
+     */
+    public function from(string $source): array
+    {
+        return array_values(array_filter(
+            $this->kinds,
+            fn (Kind $kind): bool => $kind->source === $source,
+        ));
+    }
+
+    /**
+     * Extra app-tree containers contributed by registered kinds.
+     *
+     * Built-in containers stay on AppTree. A package kind adds its own
+     * parent key here so a dot path can reach it.
+     *
+     * @return array<string, array<string, array{type: string, map: bool, map_of?: string}>>
+     */
+    public function treeContainers(): array
+    {
+        $containers = [];
+
+        foreach ($this->kinds as $kind) {
+            $placement = $kind->placement;
+
+            if ($placement === null) {
+                continue;
+            }
+
+            if (isset($containers[$placement->parent][$placement->key])) {
+                throw new KindRegistryException("Container [{$placement->parent}.{$placement->key}] is already claimed by a component kind.");
+            }
+
+            $spec = [
+                'type' => $placement->map ? $placement->key : $kind->resolvedType(),
+                'map' => $placement->map,
+            ];
+
+            if ($placement->map) {
+                $spec['map_of'] = $placement->mapOf ?? $kind->resolvedType();
+            }
+
+            $containers[$placement->parent][$placement->key] = $spec;
+        }
+
+        return $containers;
+    }
+
+    protected function add(Kind $kind): void
+    {
+        if (isset($this->kinds[$kind->name])) {
+            throw new KindRegistryException("Component kind [{$kind->name}] is already registered.");
+        }
+
+        $type = $kind->resolvedType();
+
+        if (isset($this->byType[$type])) {
+            throw new KindRegistryException("Node type [{$type}] is already bound to component kind [{$this->byType[$type]}].");
+        }
+
+        $this->kinds[$kind->name] = $kind;
+        $this->byType[$type] = $kind->name;
+    }
+}
